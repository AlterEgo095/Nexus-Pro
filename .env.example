# NEXUS Ultimate Environment Variables
# Copy this file to .env and fill in your actual values

# API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# Configuration
NEXUS_MODE=auto  # auto, supervised, debug
NEXUS_PLATFORM=telegram  # telegram, web, api
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Performance
NEXUS_MAX_PARALLEL_TOOLS=5
NEXUS_TIMEOUT=120
NEXUS_CACHE_ENABLED=true
NEXUS_CACHE_TTL=3600

# Features
NEXUS_PROACTIVE_SUGGESTIONS=true
NEXUS_METRICS_ENABLED=true

# Optional: Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexus

# Optional: Redis
REDIS_URL=redis://localhost:6379/0

# Optional: Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn-here
